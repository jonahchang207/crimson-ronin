{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "color": { "1": "red", "2": "red" } },
  "display": { "separator": "  ", "key": { "width": 9 }, "color": { "keys": "red", "separator": "bright_black", "output": "white" } },
  "modules": [
    { "type": "title", "color": { "user": "red", "at": "bright_black", "host": "white" } }, "break",
    { "type": "os", "key": "OS" }, { "type": "kernel", "key": "Kernel" },
    { "type": "wm", "key": "WM" }, { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" }, { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" }, { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" }, { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "display", "key": "Display", "compactType": "original-with-refresh-rate" }
  ]
}
